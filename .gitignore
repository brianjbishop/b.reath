# Python
**/.venv/
**/.venv.bak*/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/dist/
**/build/

# Logs
**/*.log

# macOS
**/.DS_Store
**/.AppleDouble

# Large media — host separately (YouTube, SoundCloud, etc.)
**/*.mov
**/stems/
**/*.asd
**/*.als

# IDE / editor artifacts
**/.cursor/
**/.idea/
**/*.swp

# Claude local settings
**/.claude/settings.local.json

# Built macOS app wrapper — regenerate with breath-choir-aug-13/make_app.command.
# Not committed: it embeds an absolute path to the local .venv, which is itself
# ignored, so a checked-in bundle would be broken on any other machine.
**/b.reath.app/

# Crash / recovered-error log written at runtime.
**/breath.log
